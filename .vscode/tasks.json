{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tools: Build scrapper",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/tools/main.cs",
        "--output",
        "${env:TEMP}/tbapi_tools_main"
      ],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": true,
      }
    }
  ]
}
